{
  "name": "7zi-frontend",
  "version": "1.3.0",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/i18n/**/*",
    "**/*.stories.@(ts|tsx|js|jsx)"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "NODE_ENV=production next build --webpack",
    "build:turbopack": "NODE_ENV=production next build",
    "build:analyze": "NODE_ENV=production ANALYZE=true next build --turbopack",
    "build:analyze:webpack": "NODE_ENV=production ANALYZE=true USE_WEBPACK=true next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:e2e",
    "test:ci": "vitest run --reporter=junit --reporter=json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.27",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "i18next": "^26.0.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-i18next": "^16.0.4",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.1",
    "socket.io-client": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "undici": "^7.24.6",
    "uuid": "^13.0.0",
    "web-vitals": "^5.2.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@faker-js/faker": "^8.4.0",
    "@playwright/test": "^1.42.0",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-onboarding": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/nextjs-vite": "^10.3.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-storybook": "^10.3.3",
    "jsdom": "^24.0.0",
    "msw": "^2.2.0",
    "playwright": "^1.58.2",
    "storybook": "^10.3.3",
    "typescript": "^5.3.0",
    "vite": "^8.0.3",
    "vitest": "^1.3.0"
  }
}
