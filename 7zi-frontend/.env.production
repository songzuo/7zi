# ==========================================
# 应用配置
# ==========================================

# 运行环境 (development, production, test)
NODE_ENV=production

# 应用 URL
NEXT_PUBLIC_APP_URL=https://7zi.com

# ==========================================
# 安全配置 - 🔒 重要！
# ==========================================

# JWT 密钥 - 用于生成和验证 JWT 令牌
# ⚠️ 生产环境必须使用强随机密钥！
# 生成方法: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 最小长度: 64 字符
# 安全说明：
#   - 生产环境: 必须设置，否则应用将启动失败并抛出致命错误
#   - 密钥强度: 使用 256 位（64 十六进制字符）的随机密钥用于 HS256 算法
#   - 轮换建议: 每 3-6 个月轮换一次密钥，使用 JWT 版本号实现平滑过渡
JWT_SECRET=8861d60e34463a2e0feafb90a6e249edaa1322c7fb7361f87cd1d227adbf4d8ddf84c27814c5069bea57595df00c7484fb76f3fa7b2b33ba72fc583047a2047f

# JWT 过期时间
JWT_EXPIRES_IN=24h

# JWT 刷新令牌过期时间
JWT_REFRESH_EXPIRES_IN=7d

# 会话密钥（用于 Cookie 签名）
SESSION_SECRET=your-session-secret-change-this-at-least-32-characters

# ==========================================
# 数据库配置
# ==========================================

# MongoDB 连接 URL
# ⚠️ 生产环境请替换为实际的数据库地址
DATABASE_URL=mongodb://localhost:27017/7zi

# 数据库连接池大小
DB_POOL_MAX=10

# ==========================================
# Redis 配置（可选，用于速率限制和缓存）
# ==========================================

# Redis 连接 URL
REDIS_URL=redis://localhost:6379

# ==========================================
# CORS 配置
# ==========================================

# 允许的源（逗号分隔）
ALLOWED_ORIGINS=https://7zi.com,https://www.7zi.com

# 允许的方法
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH

# 允许的请求头
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# ==========================================
# 速率限制配置
# ==========================================

# 全局速率限制（请求/分钟）
RATE_LIMIT_GLOBAL=100

# API 速率限制
RATE_LIMIT_API=60

# 登录速率限制
RATE_LIMIT_LOGIN=5

# 注册速率限制
RATE_LIMIT_REGISTER=10

# 搜索速率限制
RATE_LIMIT_SEARCH=30

# ==========================================
# 邮件配置（可选）
# ==========================================

# SMTP 服务器
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password

# 邮件发件人
MAIL_FROM=noreply@7zi.com
MAIL_FROM_NAME=7zi Team

# ==========================================
# 监控和日志
# ==========================================

# Sentry DSN（错误追踪）
# 生产环境应该配置真实的 Sentry DSN
# 格式: https://<key>@o<org>.ingest.sentry.io/<project>
# 开发/测试环境可以使用空值或占位符
SENTRY_DSN=https://placeholder@o000000.ingest.sentry.io/0000000

# Sentry 环境
SENTRY_ENVIRONMENT=production

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=warn

# 是否启用审计日志
AUDIT_LOG_ENABLED=true

# ==========================================
# 第三方服务（可选）
# ==========================================

# Google Analytics
NEXT_PUBLIC_GA_ID=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# Recaptcha v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ==========================================
# 文件上传配置
# ==========================================

# 最大文件大小（字节）- 默认 10MB
MAX_FILE_SIZE=10485760

# 允许的文件类型（逗号分隔）
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# 上传目录
UPLOAD_DIR=./uploads

# ==========================================
# 安全模式
# ==========================================

# 启用安全模式（额外的安全检查）
SECURITY_MODE=true

# 启用 CSRF 保护
CSRF_PROTECTION=true

# 启用 HTTP 严格传输安全（仅 HTTPS）
HSTS_ENABLED=true

# ==========================================
# Next.js 特定配置
# ==========================================

# 站点 URL（用于图片优化）
NEXT_PUBLIC_SITE_URL=https://7zi.com

# 图片域名白名单
NEXT_PUBLIC_IMAGE_DOMAINS=

# ==========================================
# 测试配置
# ==========================================

# 测试数据库 URL
TEST_DATABASE_URL=mongodb://localhost:27017/7zi-test

# 测试模式
TESTING=false

# ==========================================
# 开发工具
# ==========================================

# 是否启用调试模式
DEBUG=false

# 是否显示堆栈跟踪（仅开发）
SHOW_STACK_TRACE=false
