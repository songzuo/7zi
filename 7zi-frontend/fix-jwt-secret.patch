# 修复 src/features/auth/lib/jwt.ts
sed -i "s/const JWT_SECRET = new TextEncoder().encode(/const JWT_SECRET = new TextEncoder().encode(\\n  process.env.JWT_SECRET || (() => {\\n    if (process.env.NODE_ENV === 'production') {\\n      throw new Error(\\n        'FATAL: JWT_SECRET must be set in production environment.\\\\n' +\\n        \"Generate one with: node -e \\\"console.log(require('\\\\'crypto\\\\').randomBytes(64).toString('\\\\'hex\\\\'))\\\"\"\\n      );\\n    }\\n    return 'development-secret-change-in-production';\\n    }\\n  })()/" src/features/auth/lib/jwt.ts
```

