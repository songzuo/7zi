# ========================================
# 7zi-frontend 生产环境配置
# 服务器: 7zi.com
# ========================================

# 应用配置
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ========================================
# 网站统计配置（按需启用）
# ========================================

# Google Analytics 4
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Umami Analytics
# NEXT_PUBLIC_UMAMI_ID=your-umami-website-id
# NEXT_PUBLIC_UMAMI_URL=https://analytics.umami.is

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_ID=7zi.com

# 百度统计
# NEXT_PUBLIC_BAIDU_ID=your-baidu-id

# ========================================
# 联系表单邮件服务配置
# ========================================

# Resend API Key
# RESEND_API_KEY=re_your_production_api_key

# 邮件配置
# CONTACT_EMAIL=business@7zi.studio
# FROM_EMAIL=noreply@7zi.studio

# ========================================
# GitHub API 配置（服务端，不暴露到客户端）
# ========================================

# GitHub Personal Access Token（用于 Dashboard API 代理）
# 注意：不要使用 NEXT_PUBLIC_ 前缀！
# 从 https://github.com/settings/tokens 获取
# GITHUB_TOKEN=ghp_your_production_token

# GitHub 仓库配置（公开信息）
NEXT_PUBLIC_GITHUB_OWNER=songzhuo
NEXT_PUBLIC_GITHUB_REPO=openclaw-workspace

# ========================================
# Sentry 错误监控（可选）
# ========================================

# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_AUTH_TOKEN=your-auth-token
# SENTRY_ORG=your-org
# SENTRY_PROJECT=7zi-frontend