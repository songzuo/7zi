# 网站统计配置
# 复制此文件为 .env.local 并填入您的统计服务 ID

# Google Analytics 4 Measurement ID
# 格式：G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Umami Analytics
# 网站 ID（在 Umami 后台获取）
NEXT_PUBLIC_UMAMI_ID=
# Umami 服务器地址（可选，默认使用官方服务）
NEXT_PUBLIC_UMAMI_URL=https://analytics.umami.is

# Plausible Analytics
# 您的域名
NEXT_PUBLIC_PLAUSIBLE_ID=7zi.studio

# 百度统计
# 百度统计 ID（在百度统计后台获取）
NEXT_PUBLIC_BAIDU_ID=

# ========================================
# GitHub API 配置（服务端，不暴露到客户端）
# ========================================

# GitHub Personal Access Token（用于 Dashboard API 代理）
# 注意：不要使用 NEXT_PUBLIC_ 前缀，否则会暴露到客户端
# 从 https://github.com/settings/tokens 获取
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub 仓库配置（公开信息，可使用 NEXT_PUBLIC_）
NEXT_PUBLIC_GITHUB_OWNER=songzhuo
NEXT_PUBLIC_GITHUB_REPO=openclaw-workspace

# ========================================
# 联系表单邮件服务配置 (Resend)
# ========================================

# Resend API Key
# 从 https://resend.com/api-keys 获取
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 邮件接收地址（接收联系表单的邮箱）
CONTACT_EMAIL=business@7zi.studio

# 发件人地址
# 开发环境使用: onboarding@resend.dev
# 生产环境使用您验证过的域名: noreply@yourdomain.com
FROM_EMAIL=onboarding@resend.dev
