# ============================================================================
# React Compiler Configuration
# ============================================================================
# 可选功能：启用 React Compiler 以减少不必要的重新渲染 (20-40% 减少)
# 值: true | false (默认: false)
# 注意: 此为服务端环境变量，用于构建时配置
ENABLE_REACT_COMPILER=false

# 客户端可见的 React Compiler 启用状态 (用于运行时检查和调试)
# 值: true | false (默认: false)
NEXT_PUBLIC_REACT_COMPILER_ENABLED=false

# React Compiler 编译模式
# 值: opt-in (只编译指定目录) | opt-out (编译除黑名单外的所有文件) | all (编译所有)
# 默认: opt-out
REACT_COMPILER_MODE=opt-out

# React Compiler 排除文件模式 (逗号分隔的 glob 模式)
# 用于排除不兼容或不需要优化的文件
# 示例: **/third-party/**,**/legacy/**,**/components/SimpleButton.tsx
# 默认: 空字符串 (不排除)
REACT_COMPILER_EXCLUDE_PATTERNS=

# ============================================================================
# Redis Configuration (for Rate Limiting & Caching)
# ============================================================================

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis TLS (optional, for production)
REDIS_TLS=false
REDIS_TLS_CERT=
REDIS_TLS_KEY=
REDIS_TLS_CA=

# Redis Connection Pool
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=100
REDIS_ENABLE_READY_CHECK=true

# Rate Limiting Configuration
# Enable Redis-based distributed rate limiting (recommended for production)
# If disabled, falls back to in-memory rate limiting
RATE_LIMIT_REDIS_ENABLED=false

# Rate Limit Presets (requests per minute)
# Auth endpoints: strict (5 req/min)
# Task endpoints: moderate (30 req/min)
# General API: lenient (100 req/min)
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_TASKS_MAX=30
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# Slack Alerting Configuration
# ============================================================================

# Slack Incoming Webhook URL
# Create at: https://api.slack.com/messaging/webhooks
# Format: https://hooks.slack.com/services/Txxx/Bxxx/xxx
SLACK_WEBHOOK_URL=

# Enable Slack alerting (default: true if webhook is set, false otherwise)
SLACK_ALERTING_ENABLED=true

# Minimum alert level to send to Slack (default: warning)
# Values: info, warning, error, critical
SLACK_ALERT_MIN_LEVEL=warning

# Slack channel override (uses webhook default if not specified)
# Example: #alerts
SLACK_CHANNEL=

# Slack username override (default: 7zi Monitoring)
SLACK_USERNAME=7zi Monitoring

# Slack icon emoji override (default: :bell:)
SLACK_ICON_EMOJI=:bell:

# Slack retry configuration
SLACK_RETRY_MAX_ATTEMPTS=3
SLACK_RETRY_DELAY_MS=1000
SLACK_RETRY_BACKOFF=2

# ============================================================================
# AI API Providers Configuration
# ============================================================================

# MiniMax (当前主力)
MINIMAX_API_KEY=

# Volcengine (多模态 - 当前有 401 问题)
VOLCENGINE_API_KEY=
VOLCENGINE_REGION=cn-north-1

# SiliconFlow (推荐 - 聚合 API)
# 注册地址: https://siliconflow.cn
SILICONFLOW_API_KEY=

# 阿里云百炼 (DashScope)
DASHSCOPE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# DeepSeek (官方)
DEEPSEEK_API_KEY=

# Zhipu (GLM)
ZHIPU_API_KEY=
