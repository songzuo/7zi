# ============================================
# 7zi-frontend 环境变量完整示例
# ============================================
# 用法：
# 1. 开发环境：复制此文件为 .env.local
# 2. 生产环境：复制为 .env.production
# 3. 测试环境：参考 .env.test

# ============================================
# 基础应用配置
# ============================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# 应用 URL（用于 NextAuth 等）
NEXT_PUBLIC_APP_URL=https://7zi.com

# ============================================
# 网站统计配置（按需启用）
# ============================================

# Google Analytics 4 Measurement ID
# 格式：G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Umami Analytics
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_UMAMI_URL=https://analytics.umami.is

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_ID=7zi.studio

# 百度统计
NEXT_PUBLIC_BAIDU_ID=

# ============================================
# 邮件服务配置 (Resend)
# ============================================
# API Key: https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_EMAIL=business@7zi.studio
FROM_EMAIL=noreply@7zi.studio

# ============================================
# 实时通知配置
# ============================================
# Socket.IO 服务器 URL（客户端）
NEXT_PUBLIC_NOTIFICATION_SOCKET_URL=http://localhost:3001
# Socket.IO 服务器端口（服务端）
NOTIFICATION_SOCKET_PORT=3001
# 通知数据库路径
NOTIFICATION_DATABASE_PATH=/data/notifications.db

# ============================================
# GitHub API 配置（服务端专用）
# ============================================
# ⚠️ 注意：不要使用 NEXT_PUBLIC_ 前缀，否则会暴露到客户端！
GITHUB_TOKEN=
NEXT_PUBLIC_GITHUB_OWNER=songzhuo
NEXT_PUBLIC_GITHUB_REPO=openclaw-workspace

# ============================================
# 认证配置（如使用 NextAuth）
# ============================================
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://7zi.com
JWT_SECRET=

# ============================================
# 数据库配置
# ============================================
DATABASE_PATH=/data/7zi.db
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30000

# ============================================
# Redis 缓存配置（可选）
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ============================================
# Sentry 错误监控（可选）
# ============================================
# 详细配置见 .env.sentry.example
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# A2A 网关配置（智能体通信）
# ============================================
A2A_GATEWAY_URL=
A2A_GATEWAY_TOKEN=

# ============================================
# 性能监控和日志
# ============================================
LOG_LEVEL=info
PERFORMANCE_LOG_LEVEL=warn
ENABLE_PERFORMANCE_MONITORING=true

# ============================================
# 缓存配置
# ============================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ============================================
# 速率限制
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# 部署配置
# ============================================
# Docker 镜像版本
VERSION=latest

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=30

# 最大日志文件大小（MB）
MAX_LOG_SIZE=50

# ============================================
# 开发专用（生产环境留空）
# ============================================
NEXT_PUBLIC_SENTRY_DEBUG=false
