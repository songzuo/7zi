# Dockerfile for Auth Service
# Multi-stage build for optimal image size

# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --only=production && \
    npm cache clean --force

# Copy source code
COPY . .

# Build TypeScript
RUN npm run build

# Stage 2: Production
FROM node:22-alpine AS production

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init curl

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S openclaw -u 1001

WORKDIR /app

# Copy built files from builder
COPY --from=builder --chown=openclaw:nodejs /app/dist ./dist
COPY --from=builder --chown=openclaw:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=openclaw:nodejs /app/package.json ./package.json

# Create necessary directories
RUN mkdir -p /app/data /app/logs /app/exports && \
    chown -R openclaw:nodejs /app/data /app/logs /app/exports

# Switch to non-root user
USER openclaw

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start the application
CMD ["node", "dist/server.js"]