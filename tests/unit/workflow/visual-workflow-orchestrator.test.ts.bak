/**
 * Visual Workflow Orchestrator 单元测试
 */
import { describe, it, expect, vi, beforeEach } from 'vitest'
import { VisualWorkflowOrchestrator, visualWorkflowOrchestrator } from '@/lib/workflow/VisualWorkflowOrchestrator'
import type { WorkflowDefinition, WorkflowNode, NodeStatus } from '@/types/workflow'

describe('VisualWorkflowOrchestrator', () => {
  describe('基础功能', () => {
    it('should be a singleton instance', () => {
      expect(visualWorkflowOrchestrator).toBeInstanceOf(VisualWorkflowOrchestrator)
    })

    it('should have required methods', () => {
      const orchestrator = new VisualWorkflowOrchestrator()
      expect(typeof orchestrator.create).toBe('function')
      expect(typeof orchestrator.execute).toBe('function')
      expect(typeof orchestrator.pause).toBe('function')
      expect(typeof orchestrator.resume).toBe('function')
      expect(typeof orchestrator.cancel).toBe('function')
    })
  })

  describe('工作流创建', () => {
    it('should create a workflow instance', async () => {
      const workflowDef: WorkflowDefinition = {
        id: 'test-workflow-1',
        name: 'Test Workflow',
        version: '1.0.0',
        nodes: [
          {
            id: 'start-1',
            type: 'start',
            position: { x: 0, y: 0 },
            data: {}
          },
          {
            id: 'end-1',
            type: 'end',
            position: { x: 100, y: 0 },
            data: {}
          }
        ],
        edges: []
      }

      const instance = await visualWorkflowOrchestrator.create(workflowDef)
      expect(instance).toBeDefined()
      expect(instance.id).toBeDefined()
      expect(instance.workflowId).toBe('test-workflow-1')
    })
  })

  describe('工作流执行', () => {
    it('should execute a simple workflow', async () => {
      const workflowDef: WorkflowDefinition = {
        id: 'simple-exec-test',
        name: 'Simple Execution Test',
        version: '1.0.0',
        nodes: [
          {
            id: 'start-1',
            type: 'start',
            position: { x: 0, y: 0 },
            data: {}
          },
          {
            id: 'task-1',
            type: 'task',
            position: { x: 100, y: 0 },
            data: { name: 'Test Task', input: {} }
          },
          {
            id: 'end-1',
            type: 'end',
            position: { x: 200, y: 0 },
            data: {}
          }
        ],
        edges: [
          { id: 'e1', source: 'start-1', target: 'task-1' },
          { id: 'e2', source: 'task-1', target: 'end-1' }
        ]
      }

      const instance = await visualWorkflowOrchestrator.create(workflowDef)
      const result = await visualWorkflowOrchestrator.execute(instance.id)
      
      expect(result).toBeDefined()
    })

    it('should handle execution events', async () => {
      const events: any[] = []
      const unsubscribe = visualWorkflowOrchestrator.on((event) => {
        events.push(event)
      })

      const workflowDef: WorkflowDefinition = {
        id: 'event-test',
        name: 'Event Test',
        version: '1.0.0',
        nodes: [
          { id: 'start-1', type: 'start', position: { x: 0, y: 0 }, data: {} },
          { id: 'end-1', type: 'end', position: { x: 100, y: 0 }, data: {} }
        ],
        edges: []
      }

      const instance = await visualWorkflowOrchestrator.create(workflowDef)
      await visualWorkflowOrchestrator.execute(instance.id)
      
      unsubscribe()
      expect(events.length).toBeGreaterThan(0)
    })
  })

  describe('工作流控制', () => {
    it('should pause and resume a running workflow', async () => {
      const workflowDef: WorkflowDefinition = {
        id: 'pause-test',
        name: 'Pause Test',
        version: '1.0.0',
        nodes: [
          { id: 'start-1', type: 'start', position: { x: 0, y: 0 }, data: {} },
          { id: 'end-1', type: 'end', position: { x: 100, y: 0 }, data: {} }
        ],
        edges: []
      }

      const instance = await visualWorkflowOrchestrator.create(workflowDef)
      
      // Start execution
      const execPromise = visualWorkflowOrchestrator.execute(instance.id)
      
      // Pause
      const paused = await visualWorkflowOrchestrator.pause(instance.id)
      expect(paused).toBe(true)
      
      // Resume
      const resumed = await visualWorkflowOrchestrator.resume(instance.id)
      expect(resumed).toBe(true)
      
      await execPromise
    })

    it('should cancel a workflow', async () => {
      const workflowDef: WorkflowDefinition = {
        id: 'cancel-test',
        name: 'Cancel Test',
        version: '1.0.0',
        nodes: [
          { id: 'start-1', type: 'start', position: { x: 0, y: 0 }, data: {} },
          { id: 'end-1', type: 'end', position: { x: 100, y: 0 }, data: {} }
        ],
        edges: []
      }

      const instance = await visualWorkflowOrchestrator.create(workflowDef)
      const cancelled = await visualWorkflowOrchestrator.cancel(instance.id)
      expect(cancelled).toBe(true)
    })
  })
})
