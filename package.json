{
  "name": "7zi-frontend",
  "version": "1.0.6",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "build:analyze": "NODE_ENV=production ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest",
    "test:run": "NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "test:api": "cd tests/api-integration && npx vitest run",
    "test:api:watch": "cd tests/api-integration && npx vitest",
    "test:api:coverage": "cd tests/api-integration && npx vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:all": "npm run test:run && npm run test:e2e"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "dependencies": {
    "@jest/globals": "^30.3.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sentry/nextjs": "^10.44.0",
    "@testing-library/jest-dom": "^6.9.1",
    "better-sqlite3": "^12.8.0",
    "chart.js": "^4.5.1",
    "fuse.js": "^7.1.0",
    "glob": "^13.0.6",
    "ioredis": "^5.10.1",
    "isomorphic-dompurify": "^3.6.0",
    "jose": "^6.2.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.1",
    "next-intl": "^4.8.3",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "sharp": "^0.34.5",
    "socket.io-client": "^4.8.3",
    "three": "^0.183.2",
    "uuid": "^13.0.0",
    "web-vitals": "^5.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "msw": "^2.12.14",
    "socket.io": "^4.8.3",
    "supertest": "^7.2.2",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
