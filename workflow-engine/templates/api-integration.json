{
  "id": "tpl_api_integration",
  "name": "API Integration Flow",
  "description": "Generic API integration workflow with retry logic and error handling",
  "category": "integration",
  "author": "Workflow Team",
  "tags": ["api", "http", "integration", "retry"],
  "workflow": {
    "id": "wf_api_integration",
    "name": "API Integration Flow",
    "version": "1.0.0",
    "description": "Generic API integration with retry and error handling",
    "nodes": [
      {
        "id": "start_1",
        "type": "start",
        "name": "Start",
        "position": { "x": 100, "y": 100 }
      },
      {
        "id": "http_1",
        "type": "http",
        "name": "API Request",
        "position": { "x": 300, "y": 100 },
        "data": {
          "method": "GET",
          "url": "https://api.example.com/endpoint",
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "retry": {
          "maxAttempts": 3,
          "backoffStrategy": "exponential",
          "initialDelay": 1000,
          "maxDelay": 10000
        },
        "timeout": 30
      },
      {
        "id": "condition_1",
        "type": "condition",
        "name": "Check Response",
        "position": { "x": 500, "y": 100 },
        "data": {
          "conditions": [
            {
              "expression": "output.status >= 200 && output.status < 300",
              "branch": "success"
            }
          ],
          "defaultBranch": "error"
        }
      },
      {
        "id": "transform_1",
        "type": "transform",
        "name": "Process Data",
        "position": { "x": 700, "y": 50 },
        "data": {
          "transformations": [
            {
              "type": "map",
              "config": {
                "mapping": {
                  "id": "data.id",
                  "name": "data.name",
                  "value": "data.value"
                }
              }
            }
          ]
        }
      },
      {
        "id": "end_success",
        "type": "end",
        "name": "Success",
        "position": { "x": 900, "y": 50 }
      },
      {
        "id": "end_error",
        "type": "end",
        "name": "Error",
        "position": { "x": 700, "y": 200 }
      }
    ],
    "edges": [
      { "id": "e1", "source": "start_1", "target": "http_1" },
      { "id": "e2", "source": "http_1", "target": "condition_1" },
      { "id": "e3", "source": "condition_1", "target": "transform_1", "condition": "branch === 'success'" },
      { "id": "e4", "source": "transform_1", "target": "end_success" },
      { "id": "e5", "source": "condition_1", "target": "end_error", "condition": "branch === 'error'" }
    ],
    "settings": {
      "timeout": 300,
      "maxRetries": 3,
      "enableCheckpoint": true,
      "enableParallel": true
    }
  }
}