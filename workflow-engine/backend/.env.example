# Workflow Engine v1.10.0 - Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Minimax AI Configuration
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_URL=https://api.minimax.chat
MINIMAX_MODEL=minimax-m2

# Engine Configuration
MAX_PARALLEL_TASKS=10
CHECKPOINT_INTERVAL=5000
DEFAULT_TIMEOUT=3600

# Database (Optional - for persistence)
# DATABASE_URL=postgresql://user:password@localhost:5432/workflow_engine

# Redis (Optional - for distributed execution)
# REDIS_URL=redis://localhost:6379

# Security
# JWT_SECRET=your_jwt_secret_here
# API_KEY=your_api_key_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/workflow-engine.log

# CORS (for production)
# CORS_ORIGIN=https://your-domain.com