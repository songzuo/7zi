{
  "name": "7zi-backend",
  "version": "1.14.1",
  "description": "7zi Backend Services - Unified WebSocket and Workflow Engine",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run start:websocket\" \"npm run start:workflow\"",
    "start:websocket": "node websocket/websocket-server.js",
    "start:workflow": "node workflow-engine/server.js",
    "dev": "concurrently \"npm run dev:websocket\" \"npm run dev:workflow\"",
    "dev:websocket": "nodemon websocket/websocket-server.js",
    "dev:workflow": "nodemon workflow-engine/server.js",
    "test": "npm run test:websocket && npm run test:workflow",
    "test:websocket": "jest websocket/",
    "test:workflow": "jest workflow-engine/",
    "lint": "eslint websocket/ workflow-engine/"
  },
  "keywords": [
    "7zi",
    "websocket",
    "workflow",
    "automation"
  ],
  "jest": {
    "projects": [
      {
        "displayName": "websocket",
        "rootDir": "<rootDir>",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/websocket/__tests__/**/*.test.js"
        ],
        "collectCoverageFrom": [
          "<rootDir>/websocket/lib/**/*.js"
        ],
        "coverageDirectory": "<rootDir>/coverage",
        "coverageThreshold": {
          "global": {
            "lines": 60
          }
        }
      },
      {
        "displayName": "workflow-engine",
        "rootDir": "<rootDir>/../workflow-engine/backend",
        "testEnvironment": "node",
        "collectCoverageFrom": [
          "<rootDir>/src/engine/**/*.js",
          "<rootDir>/server.js",
          "<rootDir>/websocket/**/*.js"
        ],
        "coverageDirectory": "<rootDir>/coverage",
        "coverageThreshold": {
          "global": {
            "lines": 60
          }
        }
      }
    ],
    "coverageProvider": "v8",
    "testTimeout": 20000
  },
  "author": "7zi Team",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "ajv": "^8.12.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.4",
    "uuid": "^11.1.1",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@jest/globals": "^27.5.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}