# Environment Configuration for WebSocket Service
# Copy this file to .env and update values for your environment

# Server Configuration
PORT=3002
NODE_ENV=production

# CORS - Allowed origin for WebSocket connections
# Use the frontend URL in production
ALLOWED_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# JWT Authentication
# WARNING: Change this in production! Use a strong, unique secret
# TODO (P0): Fix hardcoded demo-secret-key - see TECH_DEBT_REVIEW_20261021.md
JWT_SECRET=your-super-secret-jwt-key-here

# Redis (future: for horizontal scaling)
# REDIS_URL=redis://redis:6379
