# ==========================================
# 7zi Backend Configuration
# ==========================================

# WebSocket Server
WS_PORT=3010
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# Workflow Engine
WF_PORT=3011

# ==========================================
# Security - 🔒 CRITICAL
# ==========================================

# JWT Secret for WebSocket authentication
# ⚠️ REQUIRED in production! Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 64 characters for HS256 algorithm
# 
# Security policy:
#   - Production (NODE_ENV=production): FATAL error if not set
#   - Development: Uses insecure fallback key with warning
JWT_SECRET=

# ==========================================
# Node Environment
# ==========================================
NODE_ENV=development
