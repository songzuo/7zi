# ============================================
# 7zi-frontend Docker 环境变量模板
# 复制为 .env 并填入实际值
# ============================================

# ============================================
# 应用基础配置
# ============================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ============================================
# 数据库配置
# ============================================
DATABASE_PATH=/app/data/7zi.db

# ============================================
# 统计服务（可选）
# ============================================
# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Umami Analytics
NEXT_PUBLIC_UMAMI_ID=your-umami-website-id
NEXT_PUBLIC_UMAMI_URL=https://analytics.umami.is

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_ID=your-domain.com

# 百度统计
NEXT_PUBLIC_BAIDU_ID=your-baidu-tongji-id

# ============================================
# 邮件服务 (Resend)
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=business@7zi.studio
FROM_EMAIL=noreply@7zi.studio

# ============================================
# 安全配置
# ============================================
# JWT 密钥（用于签名 JWT token）
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CSRF 密钥
CSRF_SECRET=your-csrf-secret-key

# ============================================
# 监控和日志
# ============================================
# Sentry DSN（可选）
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ============================================
# Redis 配置（可选）
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ============================================
# 第三方服务（可选）
# ============================================
# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
