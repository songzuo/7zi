# ==========================================================================
# .npmrc —— npm 侧配置
#
# 注意：pnpm 的 node-linker 等配置**不在本文件**。
# pnpm 12 起，当项目存在 pnpm-workspace.yaml 时，不再读取项目级 .npmrc
# （实测 `pnpm config get nodeLinker` 返回 undefined）。
# node-linker=hoisted 已迁移至 pnpm-workspace.yaml 的 nodeLinker 字段。
#
# 本文件仅保留 npm 侧通用设置（开发机用 npm install 时生效）。
# ==========================================================================
fund=false
audit=false
