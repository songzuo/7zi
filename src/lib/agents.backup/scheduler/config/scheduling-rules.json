{
  "version": "1.0.0",
  "lastUpdated": "2026-03-29",
  "autoScheduleInterval": 30000,
  "maxBatchSize": 10,
  "loadThresholds": {
    "low": 30,
    "medium": 60,
    "high": 80,
    "critical": 95
  },
  "priorityWeights": {
    "urgent": 100,
    "high": 75,
    "medium": 50,
    "low": 25
  },
  "scoreWeights": {
    "capabilityMatch": 0.4,
    "loadBalance": 0.3,
    "successRate": 0.2,
    "responseTime": 0.1
  },
  "matchingRules": {
    "minCapabilityScore": 50,
    "maxCandidateCount": 5,
    "fallbackEnabled": true,
    "crossTrainingEnabled": false
  },
  "retryPolicy": {
    "maxRetries": 3,
    "backoffMultiplier": 2,
    "initialDelay": 1000,
    "maxDelay": 30000
  },
  "timeouts": {
    "taskAssignment": 5000,
    "agentResponse": 30000,
    "taskCompletion": 3600000
  },
  "healthCheck": {
    "enabled": true,
    "interval": 60000,
    "unhealthyThreshold": 3,
    "recoveryThreshold": 2
  },
  "notifications": {
    "enabled": true,
    "channels": ["telegram", "log"],
    "alertOnFailure": true,
    "alertOnOverload": true
  }
}
