/**
 * Agent Scheduler Unit Tests
 * Tests for the main orchestrator
 */

import { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';
import { AgentScheduler } from '../core/scheduler';
import { initializeAgents } from '../models/agent-capability';
import { createTask, TaskPriority } from '../models/task-model';

describe('AgentScheduler', () => {
  let scheduler: AgentScheduler;

  beforeEach(() => {
    // Use fake timers to test auto-scheduling without waiting
    vi.useFakeTimers();
    scheduler = new AgentScheduler({
      autoSchedule: false,
      maxBatchSize: 5,
      schedulingInterval: 1000
    });
  });

  afterEach(() => {
    vi.restoreAllMocks();
  });

  describe('Initialization', () => {
    it('should initialize with default configuration', () => {
      const defaultScheduler = new AgentScheduler();
      expect(defaultScheduler.getAgents().size).toBe(11);
      expect(defaultScheduler.getPendingTasks().length).toBe(0);
    });

    it('should initialize with custom configuration', () => {
      const customScheduler = new AgentScheduler({
        autoSchedule: false,
        maxBatchSize: 3,
        schedulingInterval: 5000
      });
      
      expect(customScheduler.getAgents().size).toBe(11);
      expect(customScheduler.getTaskStats().total).toBe(0);
    });

    it('should initialize agents from configuration', () => {
      const agents = scheduler.getAgents();
      expect(agents.size).toBe(11);
      
      // Check that key agents exist
      expect(agents.has('agent-expert')).toBe(true);
      expect(agents.has('executor')).toBe(true);
      expect(agents.has('tester')).toBe(true);
    });
  });

  describe('Task Management', () => {
    it('should add a single task to the queue', () => {
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Test task'
      });

      scheduler.addTask(task);
      
      expect(scheduler.getTask('task-1')).toBe(task);
      expect(scheduler.getPendingTasks().length).toBe(1);
    });

    it('should add multiple tasks', () => {
      const tasks = [
        createTask({
          id: 'task-1',
          type: 'implementation',
          title: 'Task 1'
        }),
        createTask({
          id: 'task-2',
          type: 'testing',
          title: 'Task 2'
        }),
        createTask({
          id: 'task-3',
          type: 'research',
          title: 'Task 3'
        })
      ];

      scheduler.addTasks(tasks);
      
      expect(scheduler.getAllTasks().length).toBe(3);
      expect(scheduler.getPendingTasks().length).toBe(3);
    });

    it('should return undefined for non-existent task', () => {
      expect(scheduler.getTask('non-existent')).toBeUndefined();
    });

    it('should clear all tasks', () => {
      const tasks = [
        createTask({ id: 'task-1', type: 'implementation', title: 'Task 1' }),
        createTask({ id: 'task-2', type: 'testing', title: 'Task 2' })
      ];

      scheduler.addTasks(tasks);
      expect(scheduler.getAllTasks().length).toBe(2);

      scheduler.clearTasks();
      expect(scheduler.getAllTasks().length).toBe(0);
    });
  });

  describe('Task Scheduling', () => {
    it('should schedule a compatible task to appropriate agent', async () => {
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Implement feature',
        requiredCapabilities: ['javascript'],
        estimatedDuration: 30
      });

      scheduler.addTask(task);

      const decision = await scheduler.scheduleTask('task-1');

      expect(decision).not.toBeNull();
      expect(decision?.assignedAgent).toBeDefined();
      expect(decision?.confidence).toBeGreaterThan(0);
      expect(decision?.taskId).toBe('task-1');
    });

    it('should return null for task with unsatisfied dependencies', async () => {
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Task with dependency',
        dependencies: ['non-existent-task']
      });

      scheduler.addTask(task);

      const decision = await scheduler.scheduleTask('task-1');

      expect(decision).toBeNull();
    });

    it('should return null for non-existent task', async () => {
      const decision = await scheduler.scheduleTask('non-existent');
      expect(decision).toBeNull();
    });

    it('should schedule next batch of tasks', async () => {
      const tasks = [
        createTask({ id: 'task-1', type: 'implementation', title: 'Task 1' }),
        createTask({ id: 'task-2', type: 'testing', title: 'Task 2' }),
        createTask({ id: 'task-3', type: 'research', title: 'Task 3' })
      ];

      scheduler.addTasks(tasks);

      const result = await scheduler.scheduleNextBatch();

      expect(result.success).toBe(true);
      expect(result.scheduled.length).toBe(3);
      expect(result.failed.length).toBe(0);
      expect(result.stats.totalScheduled).toBe(3);
    });

    it('should respect max batch size', async () => {
      const tasks = Array.from({ length: 10 }, (_, i) =>
        createTask({
          id: `task-${i + 1}`,
          type: 'implementation',
          title: `Task ${i + 1}`
        })
      );

      scheduler.addTasks(tasks);

      const result = await scheduler.scheduleNextBatch();

      expect(result.scheduled.length).toBe(5); // maxBatchSize
    });

    it('should rank tasks by priority before scheduling', async () => {
      const tasks = [
        createTask({
          id: 'low-priority',
          type: 'implementation',
          title: 'Low priority',
          priority: 'low'
        }),
        createTask({
          id: 'high-priority',
          type: 'implementation',
          title: 'High priority',
          priority: 'high'
        }),
        createTask({
          id: 'urgent-priority',
          type: 'implementation',
          title: 'Urgent priority',
          priority: 'urgent'
        })
      ];

      scheduler.addTasks(tasks);

      const result = await scheduler.scheduleNextBatch();

      // Urgent and high should be scheduled first
      const scheduledIds = result.scheduled.map(d => d.taskId);
      expect(scheduledIds[0]).toBe('urgent-priority');
      expect(scheduledIds[1]).toBe('high-priority');
    });
  });

  describe('Manual Assignment', () => {
    it('should manually assign task to specific agent', () => {
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Manual assignment task'
      });

      scheduler.addTask(task);

      const decision = scheduler.manualAssign('task-1', 'executor', 'user-123');

      expect(decision).not.toBeNull();
      expect(decision?.assignedAgent).toBe('executor');
      expect(decision?.manualOverride).toBe(true);
      expect(decision?.overrideBy).toBe('user-123');
      expect(decision?.confidence).toBe(1.0);
    });

    it('should throw error for manual override when not allowed', () => {
      const manualDisabledScheduler = new AgentScheduler({
        autoSchedule: false,
        allowManualOverride: false
      });

      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Task'
      });

      manualDisabledScheduler.addTask(task);

      expect(() => {
        manualDisabledScheduler.manualAssign('task-1', 'executor', 'user-123');
      }).toThrow('Manual override is not allowed');
    });

    it('should throw error for non-existent task', () => {
      expect(() => {
        scheduler.manualAssign('non-existent', 'executor', 'user-123');
      }).toThrow('Task non-existent not found');
    });

    it('should throw error for non-existent agent', () => {
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Task'
      });

      scheduler.addTask(task);

      expect(() => {
        scheduler.manualAssign('task-1', 'non-existent-agent', 'user-123');
      }).toThrow('Agent non-existent-agent not found');
    });

    it('should throw error for unavailable agent', () => {
      scheduler.setAgentAvailability('executor', false);

      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Task'
      });

      scheduler.addTask(task);

      expect(() => {
        scheduler.manualAssign('task-1', 'executor', 'user-123');
      }).toThrow('Agent executor is not available');
    });

    it('should throw error when agent has insufficient capacity', () => {
      // Increase agent load to near maximum
      const agents = scheduler.getAgents();
      const executor = agents.get('executor');
      if (executor) {
        executor.currentLoad = 85;
      }

      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Large task',
        estimatedDuration: 60
      });

      scheduler.addTask(task);

      expect(() => {
        scheduler.manualAssign('task-1', 'executor', 'user-123');
      }).toThrow('Agent executor does not have sufficient capacity');
    });
  });

  describe('Task Lifecycle', () => {
    it('should start a task', async () => {
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Task'
      });

      scheduler.addTask(task);
      await scheduler.scheduleTask('task-1');

      scheduler.startTask('task-1');

      const updatedTask = scheduler.getTask('task-1');
      expect(updatedTask?.status).toBe('in_progress');
      expect(updatedTask?.startedAt).toBeDefined();
    });

    it('should complete a task', async () => {
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Task',
        estimatedDuration: 30
      });

      scheduler.addTask(task);
      await scheduler.scheduleTask('task-1');

      const decisionBefore = scheduler.getRecentDecisions(1)[0];
      const agentId = decisionBefore?.assignedAgent || 'executor';
      const agentBefore = scheduler.getAgent(agentId);

      scheduler.completeTask('task-1');

      const updatedTask = scheduler.getTask('task-1');
      expect(updatedTask?.status).toBe('completed');
      expect(updatedTask?.completedAt).toBeDefined();

      const agentAfter = scheduler.getAgent(agentId);
      expect(agentAfter?.currentLoad).toBeLessThanOrEqual(agentBefore?.currentLoad || 100);
    });

    it('should fail a task', async () => {
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Task',
        estimatedDuration: 30
      });

      scheduler.addTask(task);
      await scheduler.scheduleTask('task-1');

      scheduler.failTask('task-1', 'Test error');

      const updatedTask = scheduler.getTask('task-1');
      expect(updatedTask?.status).toBe('failed');
      expect(updatedTask?.error).toBe('Test error');
      expect(updatedTask?.completedAt).toBeDefined();
    });

    it('should reassign a failed task to another agent', async () => {
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Task',
        estimatedDuration: 30
      });

      scheduler.addTask(task);
      const firstDecision = await scheduler.scheduleTask('task-1');

      scheduler.failTask('task-1', 'Test failure');

      const secondDecision = await scheduler.reassignTask('task-1');

      expect(secondDecision).not.toBeNull();
      expect(secondDecision?.taskId).toBe('task-1');
      // Task should be reassigned
      const updatedTask = scheduler.getTask('task-1');
      expect(updatedTask?.status).toBe('pending');
    });

    it('should return null when reassigning non-existent task', async () => {
      const decision = await scheduler.reassignTask('non-existent');
      expect(decision).toBeNull();
    });
  });

  describe('Agent Management', () => {
    it('should get all agents', () => {
      const agents = scheduler.getAgents();
      expect(agents.size).toBe(11);
    });

    it('should get specific agent by ID', () => {
      const agent = scheduler.getAgent('executor');
      expect(agent).toBeDefined();
      expect(agent?.name).toBe('Executor');
      expect(agent?.provider).toBe('volcengine');
    });

    it('should return undefined for non-existent agent', () => {
      const agent = scheduler.getAgent('non-existent');
      expect(agent).toBeUndefined();
    });

    it('should set agent availability', () => {
      expect(scheduler.getAgent('executor')?.availability).toBe(true);

      scheduler.setAgentAvailability('executor', false);
      expect(scheduler.getAgent('executor')?.availability).toBe(false);

      scheduler.setAgentAvailability('executor', true);
      expect(scheduler.getAgent('executor')?.availability).toBe(true);
    });
  });

  describe('Task Query Methods', () => {
    beforeEach(() => {
      const tasks = [
        createTask({
          id: 'task-1',
          type: 'implementation',
          title: 'Pending task',
          status: 'pending'
        }),
        createTask({
          id: 'task-2',
          type: 'testing',
          title: 'In progress task',
          status: 'in_progress'
        }),
        createTask({
          id: 'task-3',
          type: 'research',
          title: 'Completed task',
          status: 'completed'
        })
      ];

      scheduler.addTasks(tasks);
    });

    it('should get all tasks', () => {
      const allTasks = scheduler.getAllTasks();
      expect(allTasks.length).toBe(3);
    });

    it('should get pending tasks', () => {
      const pendingTasks = scheduler.getPendingTasks();
      expect(pendingTasks.length).toBe(1);
      expect(pendingTasks[0].id).toBe('task-1');
    });

    it('should get tasks by status', () => {
      const inProgressTasks = scheduler.getTasksByStatus('in_progress');
      expect(inProgressTasks.length).toBe(1);
      expect(inProgressTasks[0].id).toBe('task-2');

      const completedTasks = scheduler.getTasksByStatus('completed');
      expect(completedTasks.length).toBe(1);
      expect(completedTasks[0].id).toBe('task-3');
    });

    it('should get task statistics', () => {
      const stats = scheduler.getTaskStats();
      expect(stats.total).toBe(3);
      expect(stats.pending).toBe(1);
      expect(stats.inProgress).toBe(1);
      expect(stats.completed).toBe(1);
    });
  });

  describe('Schedule History', () => {
    it('should get schedule history', () => {
      const history = scheduler.getScheduleHistory();
      expect(history).toBeDefined();
      expect(history.getAllDecisions().length).toBe(0);
    });

    it('should get recent decisions', async () => {
      const tasks = [
        createTask({ id: 'task-1', type: 'implementation', title: 'Task 1' }),
        createTask({ id: 'task-2', type: 'testing', title: 'Task 2' })
      ];

      scheduler.addTasks(tasks);
      await scheduler.scheduleNextBatch();

      const recentDecisions = scheduler.getRecentDecisions(2);
      expect(recentDecisions.length).toBe(2);
    });

    it('should get scheduling metrics', async () => {
      const tasks = [
        createTask({ id: 'task-1', type: 'implementation', title: 'Task 1' }),
        createTask({ id: 'task-2', type: 'testing', title: 'Task 2' })
      ];

      scheduler.addTasks(tasks);
      await scheduler.scheduleNextBatch();

      const metrics = scheduler.getMetrics();
      expect(metrics.totalDecisions).toBe(2);
      expect(metrics.automaticDecisions).toBe(2);
      expect(metrics.manualOverrides).toBe(0);
    });
  });

  describe('Load Balancing', () => {
    it('should get load statistics', () => {
      const loadStats = scheduler.getLoadStats();
      expect(loadStats).toBeDefined();
      expect(loadStats.agents.length).toBe(11);
    });

    it('should get scaling suggestion', () => {
      const suggestion = scheduler.getScalingSuggestion();
      expect(suggestion).toBeDefined();
      expect(typeof suggestion.scaleNeeded).toBe('boolean');
      expect(typeof suggestion.agentIds).toBe('string');
    });
  });

  describe('Auto Scheduling', () => {
    it('should start auto scheduling on initialize when enabled', () => {
      const autoScheduler = new AgentScheduler({
        autoSchedule: true,
        schedulingInterval: 100
      });

      autoScheduler.initialize();

      // Add a task and advance timer
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Auto task'
      });
      autoScheduler.addTask(task);

      // Fast-forward time
      vi.advanceTimersByTime(150);

      // Task should be scheduled
      expect(autoScheduler.getPendingTasks().length).toBe(0);

      autoScheduler.shutdown();
    });

    it('should stop auto scheduling on shutdown', () => {
      const autoScheduler = new AgentScheduler({
        autoSchedule: true,
        schedulingInterval: 100
      });

      autoScheduler.initialize();
      autoScheduler.shutdown();

      // Advance timer - no new scheduling should happen
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Task'
      });
      autoScheduler.addTask(task);

      vi.advanceTimersByTime(200);

      // Task should still be pending
      expect(autoScheduler.getPendingTasks().length).toBe(1);
    });
  });

  describe('Configuration Updates', () => {
    it('should update scheduler configuration', () => {
      scheduler.updateConfig({
        maxBatchSize: 10,
        schedulingInterval: 60000
      });

      // Config should be updated
      // We can verify by checking behavior
      const tasks = Array.from({ length: 8 }, (_, i) =>
        createTask({
          id: `task-${i + 1}`,
          type: 'implementation',
          title: `Task ${i + 1}`
        })
      );

      scheduler.addTasks(tasks);
      scheduler.scheduleNextBatch();

      // Should schedule 8 tasks now (new maxBatchSize of 10)
      expect(scheduler.getTasksByStatus('assigned').length).toBeGreaterThan(5);
    });

    it('should update load balance configuration', () => {
      scheduler.updateConfig({
        loadBalance: {
          maxLoadThreshold: 80,
          busyThreshold: 60,
          preferLowLoad: false,
          considerSpecialization: false
        }
      });

      const loadStats = scheduler.getLoadStats();
      expect(loadStats).toBeDefined();
    });
  });

  describe('State Export and Reset', () => {
    it('should export scheduler state', () => {
      const task = createTask({
        id: 'task-1',
        type: 'implementation',
        title: 'Task'
      });

      scheduler.addTask(task);

      const exported = scheduler.export();
      const parsed = JSON.parse(exported);

      expect(parsed.config).toBeDefined();
      expect(parsed.agents).toBeDefined();
      expect(parsed.tasks).toBeDefined();
      expect(parsed.history).toBeDefined();
    });

    it('should reset scheduler state', async () => {
      const tasks = [
        createTask({ id: 'task-1', type: 'implementation', title: 'Task 1' }),
        createTask({ id: 'task-2', type: 'testing', title: 'Task 2' })
      ];

      scheduler.addTasks(tasks);
      await scheduler.scheduleNextBatch();

      expect(scheduler.getAllTasks().length).toBe(2);
      expect(scheduler.getRecentDecisions().length).toBe(2);

      scheduler.reset();

      expect(scheduler.getAllTasks().length).toBe(0);
      expect(scheduler.getRecentDecisions().length).toBe(0);
    });
  });
});
