# ============================================
# Sentry Configuration
# ============================================
# Copy this file to .env.local (or set in your deployment platform)
# and fill in your actual values.

# ============================================
# Required Configuration
# ============================================

# Sentry DSN (Data Source Name)
# Get this from your Sentry project settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxx@o123456.ingest.sentry.io/1234567

# Environment (development, staging, production)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Release version (usually set in CI/CD)
# Format: <project-name>@<version>
NEXT_PUBLIC_SENTRY_RELEASE=7zi-frontend@1.0.0

# ============================================
# SourceMap Upload (Production Only)
# ============================================

# Auth token for SourceMap upload
# Get from Sentry > Settings > Account > Auth Tokens
# Required for: sourcemap uploading in production builds
SENTRY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Organization slug (your Sentry organization)
SENTRY_ORG=7zi-studio

# Project name (must match your Sentry project name)
SENTRY_PROJECT=7zi-frontend

# ============================================
# Sampling Rates
# ============================================

# Performance tracing sample rate (0.0 - 1.0)
# Recommended: 0.1 (10%) for production, 1.0 (100%) for staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# Session replay sample rate (0.0 - 1.0)
# Recommended: 0.1 (10%) for production, 1.0 for staging
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1

# Session replay on error sample rate (0.0 - 1.0)
# Recommended: 1.0 (100%) - capture all sessions with errors
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# ============================================
# Debug Mode (Optional)
# ============================================

# Enable Sentry in development (default: false)
# Set to 'true' to test Sentry integration in development
NEXT_PUBLIC_SENTRY_DEBUG=false

# ============================================
# Quick Start Guide
# ============================================
#
# 1. Create a Sentry project:
#    - Go to https://sentry.io
#    - Create new project > Next.js
#
# 2. Get your DSN:
#    - Project Settings > Client Keys (DSN)
#    - Copy the DSN URL
#
# 3. Get your Auth Token (for SourceMap upload):
#    - Settings > Account > Auth Tokens > Create New Token
#    - Scope: project:read, project:releases
#
# 4. Test locally:
#    - Set NEXT_PUBLIC_SENTRY_DEBUG=true
#    - Run: npm run dev
#    - Throw an error to verify it appears in Sentry
#
# 5. Deploy with SourceMaps:
#    - Ensure SENTRY_AUTH_TOKEN is set in CI/CD
#    - Run: npm run build
#    - SourceMaps upload automatically
#
# ============================================