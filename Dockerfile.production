# ============================================
# 7zi-frontend Dockerfile (生产优化版 v2.1)
# 多阶段构建 + 层压缩 + 健康检查 + 安全加固
# ============================================

# ============================================
# Stage 1: Base & System Dependencies
# ============================================
FROM node:22-bookworm-slim AS base

# 合并 RUN 命令减少层数
RUN apt-get update && \
    apt-get install -y --no-install-recommends sqlite3 curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ============================================
# Stage 2: Dependencies (依赖安装阶段)
# ============================================
FROM base AS deps

# 仅复制依赖描述文件以利用缓存
COPY package*.json ./

# 安装所有依赖（包含 devDependencies，用于构建）
# 使用 --prefer-offline 加速重复构建
RUN npm ci --legacy-peer-deps --prefer-offline && \
    npm cache clean --force

# ============================================
# Stage 3: Builder (构建阶段)
# ============================================
FROM base AS builder

# 从 deps 复制所有依赖
COPY --from=deps /app/node_modules ./node_modules

# 复制源代码（复制最后，避免缓存失效）
COPY . .

# 合并环境变量到一层
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_BUILD_ID=1 \
    NODE_OPTIONS="--max-old-space-size=4096"

# 生产构建（使用 webpack 确保兼容性）
RUN npm run build:webpack && \
    npm prune --production && \
    rm -rf .next/cache

# ============================================
# Stage 4: Runner (运行阶段 - 最小化镜像)
# ============================================
FROM node:22-bookworm-slim AS runner

# 镜像元数据
LABEL maintainer="7zi.studio" \
      description="7zi-frontend production image (optimized v2.1)" \
      version="1.3.0" \
      org.opencontainers.image.title="7zi-frontend" \
      org.opencontainers.image.description="Next.js production image with multi-stage build" \
      org.opencontainers.image.source="https://github.com/7zi-studio/7zi-frontend"

# 合并 RUN 命令减少层数
RUN apt-get update && \
    apt-get install -y --no-install-recommends dumb-init sqlite3 curl && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs && \
    mkdir -p /app/data /app/logs /app/tmp && \
    chown -R nextjs:nodejs /app && \
    echo '#!/bin/sh\nset -e\ncurl -f -s --max-time 5 http://localhost:3000/api/health > /dev/null || exit 1' > /usr/local/bin/healthcheck.sh && \
    chmod +x /usr/local/bin/healthcheck.sh

WORKDIR /app

# 合并环境变量到一层
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME="0.0.0.0" \
    NODE_OPTIONS="--max-old-space-size=512" \
    TMPDIR=/app/tmp

# 复制 standalone 构建产物（仅必需文件）
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# 切换到非 root 用户
USER nextjs

# 暴露端口
EXPOSE 3000

# 健康检查（内联脚本）
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

# 使用 dumb-init 作为 PID 1（信号处理）
ENTRYPOINT ["dumb-init", "--"]

# 启动应用
CMD ["node", "server.js"]
