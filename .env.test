# 测试环境变量
NODE_ENV=test
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 数据库配置（测试环境）
DATABASE_PATH=/tmp/test-7zi.db
TEST_DATABASE_PATH=/tmp/test-7zi.db

# Redis配置（可选）
REDIS_URL=redis://localhost:6379/15

# 认证配置
NEXTAUTH_SECRET=test-secret-key-for-development-only
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=test-jwt-secret-for-testing

# GitHub API（测试用）
GITHUB_TOKEN=test_github_token
GITHUB_API_URL=https://api.github.com

# Email配置（测试用）
EMAIL_FROM=test@example.com
EMAIL_TO=test@example.com

# A2A配置
A2A_GATEWAY_URL=http://localhost:3001
A2A_GATEWAY_TOKEN=test-token

# Sentry（测试环境禁用）
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# 性能监控
PERFORMANCE_LOG_LEVEL=debug

# 缓存配置
CACHE_TTL_SECONDS=60
CACHE_ENABLED=true

# 速率限制
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# 日志级别
LOG_LEVEL=debug
