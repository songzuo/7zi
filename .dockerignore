# ============================================
# 7zi Docker Ignore File
# Exclude unnecessary files to reduce image size and build context
# ============================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store
.yarn

# Build outputs
.next
out
dist
build
*.tsbuildinfo

# Tests
coverage
.nyc_output
tests/
__tests__/
e2e/
playwright-report/
test-results/

# Git
.git
.gitignore
.github
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
*.bak

# Environment (keep .env.example but exclude .env.local)
.env
.env.local
.env.development
.env.test
.env*.local

# Logs
logs/
*.log

# Database
data/
*.db
*.sqlite
*.sqlite3

# Cache
.cache
.turbo

# OpenClaw & workspace configs (not needed in production image)
AGENTS.md
SOUL.md
USER.md
IDENTITY.md
MEMORY.md
HEARTBEAT.md
TOOLS.md

# Large dev/test directories
botmem/
archive/
xunshi-inspector/
exports/
commander/
html/
promotion/
reports/
state/
vercel/
.vercel/
bot6/
mem9/

# Deployment scripts
deploy-scripts/
deploy*.sh
*.sh

# Backups
backups/
*.tar.gz
*.zip
*.7z
*.tgz
*.rar

# Documentation (keep README and CHANGELOG for container info)
docs/
*.md
!README.md
!CHANGELOG.md

# TypeScript configs (not needed at runtime)
tsconfig.json
tsconfig.*.json

# Playwright/Vitest configs
playwright.config.ts
vitest.config.ts

# Turborepo
turbo.json

# Next.js
.next
out

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore