# ============================================
# OpenClaw v1.11.0 部署环境变量
# ============================================

# ============================================
# 基础配置
# ============================================

# 应用版本
VERSION=v1.11.0

# 环境
NODE_ENV=production

# 端口
PORT=3000

# 构建信息
BUILD_DATE=
GIT_COMMIT=

# ============================================
# 数据库配置
# ============================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=openclaw
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=openclaw

# PostgreSQL 管理员
PGADMIN_EMAIL=admin@openclaw.dev
PGADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# Redis 配置
# ============================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# 安全配置
# ============================================

# JWT 密钥（至少 32 字符）
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# Session 密钥（至少 32 字符）
SESSION_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# 加密密钥（32 字符）
ENCRYPTION_KEY=CHANGE_ME_TO_32_CHAR_STRING

# ============================================
# 监控配置
# ============================================

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================
# 功能开关
# ============================================

ENABLE_ANALYTICS=true
ENABLE_SENTRY=true
ENABLE_SWAGGER=false
ENABLE_METRICS=true

# ============================================
# 日志配置
# ============================================

LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# 性能配置
# ============================================

MAX_CONNECTIONS=100
REQUEST_TIMEOUT=30000
BODY_LIMIT=50mb

# ============================================
# 上传配置
# ============================================

UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800

# ============================================
# WebSocket 配置
# ============================================

WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=1000

# ============================================
# 第三方服务
# ============================================

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# 其他 AI 服务
MINIMAX_API_KEY=
VOLCENGINE_API_KEY=

# ============================================
# OAuth 配置
# ============================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# 邮件配置
# ============================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@openclaw.dev

# ============================================
# 统计分析
# ============================================

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_UMAMI_URL=https://analytics.umami.is
NEXT_PUBLIC_PLAUSIBLE_ID=
NEXT_PUBLIC_BAIDU_ID=

# ============================================
# 域名配置
# ============================================

DOMAIN=openclaw.example.com
API_DOMAIN=api.openclaw.example.com
WS_DOMAIN=ws.openclaw.example.com