# ========================================
# 生产环境配置示例
# 复制此文件为 .env.production 并填入实际值
# ========================================

# 网站统计配置
# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Umami Analytics
NEXT_PUBLIC_UMAMI_ID=your-umami-website-id
NEXT_PUBLIC_UMAMI_URL=https://analytics.umami.is

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_ID=7zi.com

# 百度统计
NEXT_PUBLIC_BAIDU_ID=your-baidu-id

# ========================================
# 联系表单邮件服务配置 (Resend)
# ========================================

# Resend API Key（从 https://resend.com/api-keys 获取）
RESEND_API_KEY=re_your_production_api_key

# 邮件接收地址
CONTACT_EMAIL=business@7zi.studio

# 发件人地址（使用已验证的域名）
FROM_EMAIL=noreply@7zi.studio

# ========================================
# 应用配置
# ========================================

# 生产环境
NODE_ENV=production

# 端口
PORT=3000

# 主机名
HOSTNAME=0.0.0.0
